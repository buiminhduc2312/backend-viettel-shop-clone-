{
    "name": "base-backend",
    "version": "1.0.0",
    "description": "Demo base backend",
    "main": "dist/index.js",
    "author": "HoangPh <hoang31297@gmail.com>",
    "private": true,
    "scripts": {
        "build": "npm run clean && tsc && tscpaths -p tsconfig.json -s ./src -o ./dist",
        "clean": "rimraf dist",
        "dev": "nodemon src/index.ts",
        "seed:products": "ts-node -r tsconfig-paths/register scripts/seedProducts.ts",
        "dev-worker": "nodemon src/index-worker.ts",
        "dev-consumer": "nodemon src/index-consumer.ts",
        "docker:start": "pm2-docker start ./dist/index.js",
        "docker:start-worker": "pm2-docker start ./dist/index-worker.js",
        "docker:start-consumer": "pm2-docker start ./dist/index-consumer.js",
        "db-migrate:generate": "sequelize-cli migration:generate --name",
        "db-migrate:run": "sequelize-cli db:migrate",
        "db-migrate:revert": "sequelize-cli db:migrate:undo",
        "db-migrate:revert:all": "sequelize-cli db:migrate:undo:all"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.3",
        "bull": "^4.8.1",
        "cors": "^2.8.6",
        "dayjs": "^1.11.13",
        "dotenv-safe": "^8.2.0",
        "express": "^4.17.3",
        "express-rate-limit": "^8.5.2",
        "express-validation": "^3.0.8",
        "fuse.js": "^7.4.2",
        "helmet": "^5.0.2",
        "http-status": "^1.5.0",
        "ioredis": "^4.28.5",
        "jsonwebtoken": "^9.0.3",
        "lodash": "^4.17.21",
        "module-alias": "^2.3.4",
        "moment-timezone": "^0.5.34",
        "mongoose": "^5.13",
        "morgan": "^1.10.0",
        "node-cron": "^4.4.1",
        "nodemailer": "^9.0.1",
        "pg": "^8.16.3",
        "pg-hstore": "^2.3.4",
        "pm2": "^5.2.0",
        "sequelize": "^6.37.7",
        "swagger-ui-express": "^5.0.1",
        "uuid-random": "^1.3.2",
        "winston": "^3.6.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/bluebird": "^3.5.36",
        "@types/bull": "^3.15.8",
        "@types/cors": "^2.8.19",
        "@types/dotenv-safe": "^8.1.2",
        "@types/express": "^4.17.13",
        "@types/express-rate-limit": "^5.1.3",
        "@types/ioredis": "^4.28.10",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/lodash": "^4.14.180",
        "@types/morgan": "1.9.3",
        "@types/node": "^17.0.22",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^8.0.1",
        "@types/swagger-ui-express": "^4.1.8",
        "@typescript-eslint/eslint-plugin": "^5.21.0",
        "@typescript-eslint/parser": "^5.21.0",
        "eslint": "^8.14.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-plugin-prettier": "^4.0.0",
        "nodemon": "^2.0.15",
        "prettier": "^2.6.0",
        "rimraf": "^3.0.2",
        "sequelize-cli": "^6.6.3",
        "ts-node": "^10.7.0",
        "tsc-alias": "^1.9.1",
        "tsconfig-paths": "^3.14.0",
        "tscpaths": "^0.0.9",
        "tslint": "^6.1.3",
        "typescript": "^4.6.2"
    },
    "_moduleAliases": {
        "@api": "src/api"
    }
}